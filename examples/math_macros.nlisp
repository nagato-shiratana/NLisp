; square(n) = n * n
(define-macro square
  (syntax-rules/typed
    ((square value)
     ((value (Syntax Integer)))
     (Syntax Integer)
     (* value value))))

; sum-of-squares(a, b) = a^2 + b^2
(define-macro sum-of-squares
  (syntax-rules/typed
    ((sum-of-squares a b)
     ((a (Syntax Integer)) (b (Syntax Integer)))
     (Syntax Integer)
     (+ (square a) (square b)))))

; S(n) = 1^2 + 2^2 + ... + n^2
(defun square-series ((n Integer)) Integer
  (if (<= n 0)
      0
      (+ (square n) (square-series (- n 1)))))

(defun main () Integer
  ; S(10) + 3^2 + 4^2 = 385 + 25 = 410
  (+ (square-series 10) (sum-of-squares 3 4)))
